{
  "name": "hymnix-desktop",
  "version": "1.4.2",
  "private": true,
  "description": "Hymnix Orbit - Hymnix scheduler with local gateway connectivity: orchestrate local models, serve a private OpenAI-compatible endpoint, keep every session on your machine.",
  "author": {
    "name": "Hymnix Studio"
  },
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build && node scripts/fix-renderer-html.mjs dist/renderer/index.html",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node tests/protocol.test.mjs && node --test --test-concurrency=1 tests/gateway-lifecycle.test.mjs tests/model-download.test.mjs tests/model-catalog.test.mjs tests/pull-stream.test.mjs tests/terminal-bridge.test.mjs tests/providers.test.mjs tests/components.test.mjs tests/schedule.test.mjs tests/automation.test.mjs tests/goals.test.mjs tests/skills.test.mjs tests/agents.test.mjs tests/code-nav.test.mjs tests/agent-ops.test.mjs tests/web-search.test.mjs tests/ask-present.test.mjs tests/agent-control.test.mjs tests/multimodal.test.mjs tests/lsp.test.mjs",
    "check:css": "node ../tools/check-css-tokens.mjs",
    "check:contrast": "node ../tools/check-contrast.mjs",
    "check:design": "pnpm check:css && pnpm check:contrast",
    "visual": "pnpm exec playwright test --project=electron",
    "check": "pnpm typecheck && pnpm test && pnpm check:design && pnpm build",
    "build:backend": "python -m PyInstaller --noconfirm --clean --distpath ../build/hymnix-orbit2-backend --workpath ../build/work-hymnix-orbit2-backend ../server/hymnix-server.spec",
    "dist": "pnpm build && pnpm build:backend && electron-builder --win --x64",
    "cert:selfsigned": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-self-signed-cert.ps1",
    "dist:sign": "electron-builder --win --x64"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "build": {
    "appId": "com.hymnix.orbit",
    "productName": "Hymnix Orbit",
    "copyright": "Copyright Hymnix Studio",
    "directories": {
      "output": "../release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../CHANGELOG.md",
        "to": "CHANGELOG.md"
      },
      {
        "from": "../CHANGELOG.zh-CN.md",
        "to": "CHANGELOG.zh-CN.md"
      },
      {
        "from": "../cloudflared.exe",
        "to": "cloudflared.exe"
      },
      {
        "from": "src/renderer/assets/hymnix-red-white-star.png",
        "to": "assets/hymnix-red-white-star.png"
      },
      {
        "from": "../engine-java/build/hymnix-engine.jar",
        "to": "engine-java/build/hymnix-engine.jar"
      },
      {
        "from": "../build/hymnix-orbit2-backend/hymnix-server-1.4.2-x64.exe",
        "to": "backend-gateway-headless.exe"
      },
      {
        "from": "../lsp-server",
        "to": "lsp-server"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../server/assets/hymnix-red-white-star.ico"
    },
    "nsis": {
      "include": "build-resources/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hymnix Orbit",
      "artifactName": "Hymnix-Orbit-${version}-Setup.${ext}",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ],
      "displayLanguageSelector": true,
      "uninstallDisplayName": "Hymnix Orbit ${version}"
    },
    "portable": {
      "artifactName": "Hymnix-Orbit-${version}-Portable.${ext}"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
